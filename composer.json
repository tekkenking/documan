{
    "name": "tekkenking/documan",
    "description": "Self-hosted file upload manager for Laravel with automatic image variants on any filesystem disk",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "php", "file-upload", "image", "image-resize", "thumbnails", "s3", "filesystem", "cloudinary-alternative"],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tekkenking\\Documan\\": "src/"
        },
        "files": [
            "src/DocumanHelpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tekkenking\\Documan\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Temitayo",
            "email": "bucketcodes@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Tekkenking\\Documan\\DocumanServiceProvider"
            ],
            "aliases": {
                "Documan": "DocumanFacade"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
